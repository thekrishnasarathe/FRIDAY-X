# ─── FRIDAY-X Environment Configuration ───
# Copy this file to .env and replace placeholders with your values.

# Assistant Owner name
OWNER_NAME=Boss

# Groq Cloud API Key (Get a free key at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google Gemini API Key for Vision & OCR capabilities
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP credentials for communication module (optional)
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_email_app_password

# Allowed Frontend URL for CORS (e.g., https://your-frontend.vercel.app or http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Server Port (auto-assigned on Render/Railway)
PORT=8000
